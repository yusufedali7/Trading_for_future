# Kopyala: .env.example -> .env, doldur. .env asla commit edilmez.

# Anthropic (varsayilan)
TRW_LLM_PROVIDER=anthropic
TRW_QUICK_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Ollama'ya gecmek icin (yerel, anahtar gerekmez):
# TRW_LLM_PROVIDER=ollama
# TRW_QUICK_MODEL=llama3.1:8b

TRW_OUTPUT_LANGUAGE=Turkish
