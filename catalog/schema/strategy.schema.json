{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrategyHypothesis",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "name_tr",
    "source",
    "sequence",
    "ambiguities",
    "results"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "IDEA",
        "RESEARCH",
        "TESTING",
        "VALIDATED_ON_SAMPLE",
        "PAPER",
        "LIVE_CANDIDATE"
      ]
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ]
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
