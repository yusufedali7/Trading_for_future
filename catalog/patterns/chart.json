  "expression_note": "rules alanları insan okunur ifadelerdir; ajan bunları motor koduna çevirir ve her kuralı ayrı test eder. ATR(Px) = Px mumundaki ATR(atr_period).",
  "patterns": [
    {
      "id": "double_top",
      "version": "1.0.0",
      "name_tr": "İkili Tepe",
      "name_en": "Double Top",
      "family": "reversal",
      "direction": "bearish",
      "input": "confirmed_pivots",
      "pivot_sequence": [
        "H",
        "L",
        "H"
      ],
      "params": {
        "pivot_left": 5,
        "pivot_right": 5,
        "atr_period": 14,
        "peak_tolerance_atr": 0.5,
        "min_depth_atr": 2.0,
        "min_bars_between": 10,
        "max_bars_between": 120
      },
      "rules": [
        "abs(P1.price - P3.price) <= peak_tolerance_atr * ATR(P3)",
        "min(P1.price, P3.price) - P2.price >= min_depth_atr * ATR(P3)",
        "min_bars_between <= P3.bar - P1.bar <= max_bars_between"
      ],
      "confirmation": {
        "type": "CLOSE_BELOW",
        "ref": "P2.price",
        "label": "neckline"
      },
      "invalidation": {
        "type": "CLOSE_ABOVE",
        "ref": "max(P1.price, P3.price)",
        "before": "confirmation"
      },
      "target": {
        "type": "MEASURED_MOVE",
        "from": "neckline",
        "height": "max(P1,P3) - P2"
      },
      "known_at": "confirmation mumunun kapanışı (formasyon 'forming' durumunda onaysız gösterilebilir)",
      "prototype": [
