{
  "name": "trading-research-workstation",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @trw/web",
    "build": "npm run build -w @trw/web",
    "test": "vitest run",
    "test:bridge": "py -m unittest tools/mt5-bridge/test_bridge.py",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p apps/web --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
